# 复制为 .env 后按需修改；所有项都有默认值。

# ── 服务 ─────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1

# ── 目录（相对项目根目录，也可写绝对路径）─────────────
DOWNLOAD_DIR=./downloads
DATA_DIR=./data

# ── yt-dlp 引擎 ──────────────────────────────────────
# 方式一：直接指定 yt-dlp 可执行文件（如 yt-dlp.exe）
# YTDLP_PATH=D:\tools\yt-dlp.exe
# 方式二：使用 ./yt-dlp 源码目录 + Python 解释器
# YTDLP_DIR=./yt-dlp
# YTDLP_PYTHON=C:\Python312\python.exe

# ── ffmpeg（合并 DASH 音视频，B 站高清必需）───────────
# 留空时依次探测：设置页 > ./tools/ffmpeg/bin/ffmpeg.exe > PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
